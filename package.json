  "devDependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@neoconfetti/svelte": "^2.2.2",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.6"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.25"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
